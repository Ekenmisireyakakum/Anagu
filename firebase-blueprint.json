  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Non-PII operational user profile and MetaMask wallet verification status."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection storing user email and phone."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Trusted administrator role lookup collection."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/LandApplication" },
      "description": "Land title applications submitted by users."
    },
    "/titles/{titleId}": {
      "schema": { "$ref": "#/entities/LandTitle" },
      "description": "Minted ERC-721 digital land titles."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/LandListing" },
      "description": "Verified land parcels offered for state allocation or resale acquisition."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/LandPurchase" },
      "description": "Immutable land acquisition receipts."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable registry audit trail."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Registry inquiry submissions."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionCheck" },
      "description": "Firestore connectivity check path."
    }
  }
}
