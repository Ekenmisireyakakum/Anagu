        },
        "parcelReference": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "lga": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "buyerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
