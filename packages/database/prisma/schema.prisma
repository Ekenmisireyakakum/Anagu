// ANAGU Land Administration Platform — Prisma Schema
// Database: PostgreSQL 15 + PostGIS extension
// Note: Geometry/spatial columns are managed via raw SQL migrations using PostGIS;
//       they are stored here as Json for Prisma compatibility.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum UserRole {
  CITIZEN
  SURVEYOR
  REGISTRAR
  LAND_ADMINISTRATOR
  GOVERNOR
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  PENDING_DOCUMENTS
  SPATIAL_VERIFICATION
  OWNERSHIP_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  TITLE_ISSUED
  REJECTED
  WITHDRAWN
  REVOKED
}

enum VerificationOutcome {
  PASS
  FAIL
  INCONCLUSIVE
}

// =====================================================================
// MODELS
// =====================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(CITIZEN)
  fullName      String    @map("full_name")
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  applications    Application[]    @relation("ApplicantApplications")
  ownedParcels    LandParcel[]     @relation("ParcelOwner")
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")
  notifications   Notification[]
  revokedTitles   Revocation[]     @relation("RevokedBy")

  @@map("users")
}

model LandParcel {
  id            String   @id @default(uuid())
  parcelNumber  String   @unique @map("parcel_number")
  // geometry stored as GeoJSON — PostGIS column managed via raw migration
  geometry      Json?
  areaSqm       Float?   @map("area_sqm")
  state         String   @default("Lagos")
  lga           String?  // Local Government Area
  address       String?
  status        String   @default("unregistered")
  ownerId       String?  @map("owner_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  owner         User?         @relation("ParcelOwner", fields: [ownerId], references: [id])
  applications  Application[]
  titles        LandTitle[]

  @@map("land_parcels")
}

model Application {
  id              String            @id @default(uuid())
  applicantId     String            @map("applicant_id")
  parcelId        String?           @map("parcel_id")
  status          ApplicationStatus @default(SUBMITTED)
  submittedAt     DateTime          @default(now()) @map("submitted_at")

  // Stage timestamps
  reviewStartedAt        DateTime? @map("review_started_at")
  spatialVerifiedAt      DateTime? @map("spatial_verified_at")
  ownershipVerifiedAt    DateTime? @map("ownership_verified_at")
  approvedAt             DateTime? @map("approved_at")
  titleIssuedAt          DateTime? @map("title_issued_at")
  rejectedAt             DateTime? @map("rejected_at")
  withdrawnAt            DateTime? @map("withdrawn_at")

  metadata    Json?    // Flexible metadata for additional fields
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  applicant            User                 @relation("ApplicantApplications", fields: [applicantId], references: [id])
  parcel               LandParcel?          @relation(fields: [parcelId], references: [id])
  documents            ApplicationDocument[]
  spatialVerification  SpatialVerification?
  ownershipVerification OwnershipVerification?
  title                LandTitle?

  @@map("applications")
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  fileName      String   @map("file_name")
  fileKey       String   @map("file_key")   // MinIO object key
  mimeType      String   @map("mime_type")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  // Relations
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

model SpatialVerification {
  id                String   @id @default(uuid())
  applicationId     String   @unique @map("application_id")
  isValid           Boolean  @map("is_valid")
  overlapDetected   Boolean  @default(false) @map("overlap_detected")
  overlapDetails    Json?    @map("overlap_details")  // GeoJSON of overlapping parcels
  verifiedAt        DateTime @default(now()) @map("verified_at")
  verifiedBy        String   @map("verified_by")  // Surveyor user id

  // Relations
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("spatial_verifications")
}

model OwnershipVerification {
  id                     String              @id @default(uuid())
  applicationId          String              @unique @map("application_id")
  outcome                VerificationOutcome
  institutionalMatch     Boolean             @default(false) @map("institutional_match")
  communityAttestations  Json?               @map("community_attestations")  // Array of attestation records
  verifiedAt             DateTime            @default(now()) @map("verified_at")
  verifiedBy             String              @map("verified_by")  // Registrar user id

  // Relations
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("ownership_verifications")
}

model LandTitle {
  id               String   @id @default(uuid())
  applicationId    String   @unique @map("application_id")
  parcelId         String   @map("parcel_id")
  ownerId          String   @map("owner_id")
  tokenId          String?  @map("token_id")         // ERC-721 token ID on Besu
  contractAddress  String?  @map("contract_address")
  txHash           String?  @map("tx_hash")          // Minting transaction hash
  issuedAt         DateTime @default(now()) @map("issued_at")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  revokedAt        DateTime? @map("revoked_at")
  revocationGrounds String?  @map("revocation_grounds")
  revokedBy        String?  @map("revoked_by")

  // Relations
  application      Application @relation(fields: [applicationId], references: [id])
  parcel           LandParcel  @relation(fields: [parcelId], references: [id])
  revocations      Revocation[]

  @@map("land_titles")
}

model Revocation {
  id              String   @id @default(uuid())
  titleId         String   @map("title_id")
  revokedBy       String   @map("revoked_by")  // Governor user id
  grounds         String
  legalReference  String?  @map("legal_reference")
  txHash          String?  @map("tx_hash")     // Revocation transaction hash
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  title           LandTitle @relation(fields: [titleId], references: [id])
  revokedByUser   User      @relation("RevokedBy", fields: [revokedBy], references: [id])

  @@map("revocations")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")   // null for system actions
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
