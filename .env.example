# =============================================================
# ANAGU Land Administration Platform — Environment Variables
# Copy this file to .env and fill in real values before running
# =============================================================

# Database
DATABASE_URL=postgresql://anagu:anagu_password@localhost:5432/anagu_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=anagu
DATABASE_PASSWORD=anagu_password
DATABASE_NAME=anagu_db

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=anagu_minio
MINIO_SECRET_KEY=anagu_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET_DOCUMENTS=anagu-documents

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:9001
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT Auth
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Blockchain (Besu)
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546
BESU_CHAIN_ID=1337
LAND_REGISTRY_CONTRACT_ADDRESS=
LAND_TITLE_NFT_CONTRACT_ADDRESS=

# Blockchain accounts (DO NOT COMMIT REAL KEYS)
DEPLOYER_PRIVATE_KEY=
GOVERNOR_PRIVATE_KEY=
REGISTRAR_PRIVATE_KEY=

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_MQTT_URL=ws://localhost:9001
NEXT_PUBLIC_MAPBOX_TOKEN=

# File uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
