rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'blinxtanimuyakakum@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 200));
    }

    function isValidAdminGrant(data) {
      return data.keys().hasAll(['uid', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'grantedAt'])
        && isValidId(data.uid)
        && data.grantedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'walletAddress', 'walletVerified', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'walletAddress', 'walletVerified', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['CITIZEN', 'SURVEYOR', 'REGISTRAR', 'LAND_ADMINISTRATOR', 'GOVERNOR']
        && data.walletAddress is string && data.walletAddress.size() == 42 && data.walletAddress.matches('^0x[a-fA-F0-9]{40}$')
        && data.walletVerified is bool
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLandApplication(data) {
      return data.keys().hasAll([
          'id', 'applicantId', 'applicantName', 'parcelReference', 'state', 'lga',
          'address', 'wkt', 'claimantName', 'nationalIdHash', 'documentHashes',
          'documentNames', 'status', 'spatialPassed', 'areaSqm', 'surveyConfirmed',
          'oracleOutcome', 'legalVerified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'applicantId', 'applicantName', 'parcelReference', 'state', 'lga',
          'address', 'wkt', 'claimantName', 'nationalIdHash', 'documentHashes',
          'documentNames', 'status', 'spatialPassed', 'areaSqm', 'surveyConfirmed',
          'oracleOutcome', 'legalVerified', 'tokenId', 'txHash', 'idempotencyKey',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.applicantId)
        && data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120
        && isValidId(data.parcelReference) && data.parcelReference.size() >= 2 && data.parcelReference.size() <= 64
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 64
        && data.lga is string && data.lga.size() >= 2 && data.lga.size() <= 64
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 240
        && data.wkt is string && data.wkt.size() >= 10 && data.wkt.size() <= 4000
        && data.claimantName is string && data.claimantName.size() >= 1 && data.claimantName.size() <= 120
        && data.nationalIdHash is string && data.nationalIdHash.size() >= 4 && data.nationalIdHash.size() <= 128
        && isValidBoundedStringList(data.documentHashes, 10)
        && isValidBoundedStringList(data.documentNames, 10)
        && data.status in [
          'DRAFT', 'SUBMITTED', 'UNDER_SPATIAL_REVIEW', 'UNDER_OWNERSHIP_VERIFICATION',
          'PENDING_LEGAL_VERIFICATION', 'PENDING_REGISTRAR_APPROVAL', 'APPROVED',
          'REGISTERED', 'REJECTED', 'REVOKED', 'CANCELLED'
        ]
        && data.spatialPassed is bool
        && data.areaSqm is number && data.areaSqm >= 0
        && data.surveyConfirmed is bool
        && data.oracleOutcome in ['PENDING', 'VERIFIED', 'DISPUTED', 'INCONCLUSIVE']
        && data.legalVerified is bool
        && (!('tokenId' in data) || data.tokenId is number)
        && (!('txHash' in data) || (data.txHash is string && data.txHash.size() <= 128))
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLandTitle(data) {
      return data.keys().hasAll([
          'id', 'tokenId', 'applicationId', 'parcelReference', 'address', 'lga',
          'state', 'areaSqm', 'ownerId', 'ownerName', 'ownerAddress', 'spatialHash',
          'documentHash', 'txHash', 'isRevoked', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'tokenId', 'applicationId', 'parcelReference', 'address', 'lga',
          'state', 'areaSqm', 'ownerId', 'ownerName', 'ownerAddress', 'spatialHash',
          'documentHash', 'txHash', 'isRevoked', 'revocationGrounds',
          'revocationReference', 'revocationJustification', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.tokenId is number && data.tokenId >= 1
        && isValidId(data.applicationId)
        && isValidId(data.parcelReference) && data.parcelReference.size() >= 2 && data.parcelReference.size() <= 64
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 240
        && data.lga is string && data.lga.size() >= 2 && data.lga.size() <= 64
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 64
        && data.areaSqm is number && data.areaSqm > 0
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.ownerAddress is string && data.ownerAddress.size() == 42 && data.ownerAddress.matches('^0x[a-fA-F0-9]{40}$')
        && data.spatialHash is string && data.spatialHash.size() >= 4 && data.spatialHash.size() <= 128
        && data.documentHash is string && data.documentHash.size() >= 4 && data.documentHash.size() <= 128
        && data.txHash is string && data.txHash.size() >= 4 && data.txHash.size() <= 128
        && data.isRevoked is bool
        && (!('revocationGrounds' in data) || (data.revocationGrounds is string && data.revocationGrounds.size() <= 64))
        && (!('revocationReference' in data) || (data.revocationReference is string && data.revocationReference.size() <= 128))
        && (!('revocationJustification' in data) || (data.revocationJustification is string && data.revocationJustification.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorId', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'outcome', 'details', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorId', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'outcome', 'details', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 40
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.entityType in ['APPLICATION', 'TITLE', 'PARCEL', 'USER', 'SYSTEM']
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
        && data.outcome in ['SUCCESS', 'DENIED', 'FAILED']
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll(['id', 'senderUid', 'name', 'organization', 'subject', 'message', 'createdAt'])
        && data.keys().hasOnly(['id', 'senderUid', 'name', 'organization', 'subject', 'message', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.senderUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.organization is string && data.organization.size() <= 120
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidLandListing(data) {
      return data.keys().hasAll([
          'id', 'parcelReference', 'title', 'address', 'lga', 'state', 'areaSqm',
          'zoning', 'priceNgn', 'priceEth', 'sellerId', 'sellerName', 'sellerAddress',
          'listingType', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'parcelReference', 'title', 'address', 'lga', 'state', 'areaSqm',
          'zoning', 'priceNgn', 'priceEth', 'sellerId', 'sellerName', 'sellerAddress',
          'listingType', 'status', 'tokenId', 'buyerId', 'buyerName', 'purchaseTxHash',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.parcelReference) && data.parcelReference.size() >= 2 && data.parcelReference.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 240
        && data.lga is string && data.lga.size() >= 2 && data.lga.size() <= 64
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 64
        && data.areaSqm is number && data.areaSqm > 0
        && data.zoning in ['Residential', 'Commercial', 'Mixed-Use', 'Agricultural', 'Industrial']
        && data.priceNgn is number && data.priceNgn > 0
        && data.priceEth is string && data.priceEth.size() >= 1 && data.priceEth.size() <= 32
        && isValidId(data.sellerId)
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 120
        && data.sellerAddress is string && data.sellerAddress.size() == 42 && data.sellerAddress.matches('^0x[a-fA-F0-9]{40}$')
        && data.listingType in ['STATE_ALLOCATION', 'VERIFIED_RESALE']
        && data.status in ['AVAILABLE', 'SOLD']
        && (!('tokenId' in data) || data.tokenId is number)
        && (!('buyerId' in data) || isValidId(data.buyerId))
        && (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 120))
        && (!('purchaseTxHash' in data) || (data.purchaseTxHash is string && data.purchaseTxHash.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLandPurchase(data) {
      return data.keys().hasAll([
          'id', 'listingId', 'parcelReference', 'title', 'address', 'lga',
          'buyerId', 'buyerName', 'buyerWallet', 'priceNgn', 'priceEth',
          'paymentMethod', 'txHash', 'tokenId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'listingId', 'parcelReference', 'title', 'address', 'lga',
          'buyerId', 'buyerName', 'buyerWallet', 'priceNgn', 'priceEth',
          'paymentMethod', 'txHash', 'tokenId', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.listingId)
        && isValidId(data.parcelReference) && data.parcelReference.size() >= 2 && data.parcelReference.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 240
        && data.lga is string && data.lga.size() >= 2 && data.lga.size() <= 64
        && isValidId(data.buyerId)
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 120
        && data.buyerWallet is string && data.buyerWallet.size() == 42 && data.buyerWallet.matches('^0x[a-fA-F0-9]{40}$')
        && data.priceNgn is number && data.priceNgn > 0
        && data.priceEth is string && data.priceEth.size() >= 1 && data.priceEth.size() <= 32
        && data.paymentMethod in ['REGISTRY_ESCROW', 'METAMASK_ETH', 'TRUST_WALLET_ETH', 'WEB3_WALLET_ETH']
        && data.txHash is string && data.txHash.size() >= 4 && data.txHash.size() <= 128
        && data.tokenId is number && data.tokenId >= 1
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().role == 'CITIZEN' && incoming().isActive == true) ||
          isAdmin()
        );
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().isActive == existing().isActive
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'walletAddress', 'walletVerified', 'updatedAt'])) ||
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'walletAddress', 'walletVerified', 'isActive', 'updatedAt']))
        );
      allow delete: if false;

      match /private/{infoId} {
        allow get: if isValidId(userId) && isValidId(infoId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isBootstrappedAdmin();
        allow create: if isValidId(userId) && isValidId(infoId)
          && isValidUserPrivateInfo(incoming())
          && exists(/databases/$(database)/documents/users/$(userId))
          && (isOwner(userId) || isAdmin())
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(infoId)
          && isValidUserPrivateInfo(incoming())
          && (isOwner(userId) || isAdmin())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(userId)
        && isValidAdminGrant(incoming())
        && incoming().uid == userId
        && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(userId);
    }

    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && (
        (isVerifiedUser() && existing().applicantId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.applicantId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidLandApplication(incoming())
        && incoming().id == applicationId
        && incoming().applicantId == request.auth.uid
        && incoming().status in ['SUBMITTED', 'UNDER_SPATIAL_REVIEW']
        && incoming().legalVerified == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(applicationId)
        && isValidLandApplication(incoming())
        && incoming().id == existing().id
        && incoming().applicantId == existing().applicantId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isVerifiedUser()
            && existing().applicantId == request.auth.uid
            && !(existing().status in ['REGISTERED', 'REVOKED', 'CANCELLED'])
            && incoming().status == 'CANCELLED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isAdmin()
            && !(existing().status in ['REGISTERED', 'REVOKED'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'spatialPassed', 'areaSqm', 'surveyConfirmed',
              'oracleOutcome', 'legalVerified', 'tokenId', 'txHash', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    match /titles/{titleId} {
      allow get: if isValidId(titleId) && (
        (isVerifiedUser() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(titleId)
        && isAdmin()
        && isValidLandTitle(incoming())
        && incoming().id == titleId
        && incoming().isRevoked == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/applications/$(incoming().applicationId));
      allow update: if isValidId(titleId)
        && isAdmin()
        && isValidLandTitle(incoming())
        && incoming().id == existing().id
        && incoming().tokenId == existing().tokenId
        && incoming().applicationId == existing().applicationId
        && incoming().parcelReference == existing().parcelReference
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().isRevoked == false
        && (
          (incoming().isRevoked == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'ownerName', 'ownerAddress', 'txHash', 'updatedAt'])) ||
          (incoming().isRevoked == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isRevoked', 'revocationGrounds', 'revocationReference', 'revocationJustification', 'txHash', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (
        (isVerifiedUser() && existing().actorId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.actorId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && (incoming().actorId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /contacts/{contactId} {
      allow get: if isValidId(contactId) && (
        (isVerifiedUser() && existing().senderUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.senderUid == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(contactId)
        && isVerifiedUser()
        && isValidContactInquiry(incoming())
        && incoming().id == contactId
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /listings/{listingId} {
      allow get, list: if isVerifiedUser();
      allow create: if isValidId(listingId)
        && isVerifiedUser()
        && isValidLandListing(incoming())
        && incoming().id == listingId
        && (incoming().sellerId == request.auth.uid || isAdmin())
        && incoming().status == 'AVAILABLE'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(listingId)
        && isVerifiedUser()
        && isValidLandListing(incoming())
        && incoming().id == existing().id
        && incoming().parcelReference == existing().parcelReference
        && incoming().sellerId == existing().sellerId
        && incoming().priceNgn == existing().priceNgn
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'AVAILABLE'
        && incoming().status == 'SOLD'
        && incoming().buyerId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'buyerId', 'buyerName', 'purchaseTxHash', 'tokenId', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /purchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && (
        (isVerifiedUser() && existing().buyerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.buyerId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isValidId(purchaseId)
        && isVerifiedUser()
        && isValidLandPurchase(incoming())
        && incoming().id == purchaseId
        && incoming().buyerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
